{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["Data"],
  "properties": {
    "Data": {
      "type": "object",
      "required": ["TrackingID", "SenderBusinessSystem", "Customer1", "Customer2PresentFlag"],
      "properties": {
        "TrackingID": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "SenderBusinessSystem": {
          "type": "string"
        },
        "Customer1": {
          "type": "object",
          "required": ["Identification", "BPID", "LegalName", "Country", "City", "Region", "Street", "HouseNumber", "PostalCode", "Language", "PhoneNumber", "Email", "IsAcctLinkageSource", "TargetSourceSystem", "BusinessUnit", "SalesArea", "PersonaType", "NaturalPersonFlag", "TransportationZone", "CompanyCodeData", "GlobalRelationshipData", "ControlForm", "TaxNumber"],
          "properties": {
            "Identification": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "item": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["SourceSystemID", "SourceSystem"],
                    "properties": {
                      "SourceSystemID": {
                        "type": "string"
                      },
                      "SourceSystem": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "BPID": {
              "type": "string"
            },
            "LegalName": {
              "type": "string"
            },
            "Country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "City": {
              "type": "string"
            },
            "Region": {
              "type": "string"
            },
            "Street": {
              "type": "string"
            },
            "HouseNumber": {
              "type": "string"
            },
            "PostalCode": {
              "type": "string"
            },
            "Language": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "PhoneNumber": {
              "type": "string"
            },
            "Email": {
              "type": "string",
              "format": "email"
            },
            "IsAcctLinkageSource": {
              "type": "boolean"
            },
            "TargetSourceSystem": {
              "type": "string"
            },
            "BusinessUnit": {
              "type": "string"
            },
            "SalesArea": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "item": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["SalesOrg", "DistributionChannel", "Division"],
                    "properties": {
                      "SalesOrg": {
                        "type": "string"
                      },
                      "DistributionChannel": {
                        "type": "string"
                      },
                      "Division": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "PersonaType": {
              "type": "string"
            },
            "NaturalPersonFlag": {
              "type": "boolean"
            },
            "TransportationZone": {
              "type": "string"
            },
            "CompanyCodeData": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "item": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["CompanyCode"],
                    "properties": {
                      "CompanyCode": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "GlobalRelationshipData": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "item": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["GlobalRelationshipType", "GlobalRelationship_BPID"],
                    "properties": {
                      "GlobalRelationshipType": {
                        "type": "string"
                      },
                      "GlobalRelationship_BPID": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "ControlForm": {
              "type": "object",
              "required": ["IsOrderingAccount", "IsGoodsDelivered", "IsInvoiceFormReceived", "IsPayerAccount", "DomesticOrExport", "IsPrevalidated", "IsPartyReceivingFinance"],
              "properties": {
                "IsOrderingAccount": {
                  "type": "string",
                  "enum": ["True", "False"]
                },
                "IsGoodsDelivered": {
                  "type": "string",
                  "enum": ["True", "False"]
                },
                "IsInvoiceFormReceived": {
                  "type": "string",
                  "enum": ["True", "False"]
                },
                "IsPayerAccount": {
                  "type": "string",
                  "enum": ["True", "False"]
                },
                "DomesticOrExport": {
                  "type": "string",
                  "enum": ["DOMESTIC", "EXPORT"]
                },
                "IsPrevalidated": {
                  "type": "string"
                },
                "IsPartyReceivingFinance": {
                  "type": "string",
                  "enum": ["True", "False"]
                }
              }
            },
            "TaxNumber": {
              "type": "object",
              "required": ["item"],
              "properties": {
                "item": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["TaxType", "TaxID"],
                    "properties": {
                      "TaxType": {
                        "type": "string"
                      },
                      "TaxID": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "Customer2PresentFlag": {
          "type": "boolean"
        }
      }
    }
  }
}